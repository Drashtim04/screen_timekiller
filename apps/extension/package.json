{
  "name": "@deepwork/extension",
  "displayName": "DeepWork AI",
  "version": "0.0.1",
  "description": "AI-powered focus operating system",
  "author": "DeepWork",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@deepwork/shared": "*",
    "@supabase/supabase-js": "^2.39.3",
    "lucide-react": "^0.294.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@deepwork/eslint-config": "*",
    "@deepwork/tsconfig": "*",
    "@plasmohq/prettier-plugin-sort-imports": "*",
    "@types/chrome": "0.0.254",
    "@types/node": "20.10.4",
    "@types/react": "18.2.43",
    "@types/react-dom": "18.2.17",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*"
    ],
    "permissions": [
      "storage",
      "tabs",
      "webNavigation",
      "alarms",
      "notifications"
    ],
    "externally_connectable": {
      "matches": [
        "http://localhost:5173/*"
      ]
    }
  }
}
